rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para base de datos y sincronización del POS
    match /pos_data/{document=**} {
      allow read, write: if true;
    }
    // Reglas para contadores fiscales transaccionales atómicos
    match /fiscal_counters/{document=**} {
      allow read, write: if true;
    }
    // Reglas para comprobantes electrónicos emitidos
    match /electronic_documents/{document=**} {
      allow read, write: if true;
    }
    // Reglas para ventas consolidadas
    match /sales/{document=**} {
      allow read, write: if true;
    }
    // Reglas para la colección individual de comandas KDS (kitchenOrders)
    // Validación estricta de esquema y prohibición de borrado
    match /kitchenOrders/{orderId} {
      allow read: if true;
      allow create, update: if request.resource.data.kitchenOrderId == orderId
                            && request.resource.data.orderNumber is number
                            && request.resource.data.items is list;
      allow delete: if false;
    }
    // Fallback general para colecciones auxiliares existentes
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
